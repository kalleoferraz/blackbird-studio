{
  "name": "audiobook-studio",
  "version": "0.0.1",
  "private": true,
  "description": "Audiobook Studio: write, record and organize a multi-character audiobook in one place.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
