HOST=0.0.0.0
PORT=3000

# MySQL (injected by the host in production)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Snapshot repo (the host reserves GITHUB_* names)
SNAPSHOT_REPO_TOKEN=
SNAPSHOT_REPO=

# Login (src/auth). SESSION_SECRET: at least 32 random characters, for example `openssl rand -base64 48`.
SESSION_SECRET=
# The admin account. ADMIN_PASSWORD creates it when no account has that email (remove it after the first login).
# RESET_ADMIN_PASSWORD resets the admin password at every start while it is set (lock-out recovery; remove it afterwards).
ADMIN_EMAIL=
ADMIN_PASSWORD=
RESET_ADMIN_PASSWORD=
# 1 drops the Secure flag of the cookie, for plain-http local runs in Safari.
COOKIE_INSECURE=
