PREVIEW_SERVER_URL=
PUBLIC_SERVER_URL=

# Local development only (loaded by npm run dev). Not committed.
HOST=127.0.0.1
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=redaction_dev
DB_USER=redaction
DB_PASSWORD=

# Left empty on purpose: local runs must not write to the real snapshot repo.
SPIKE_TOKEN=
SNAPSHOT_REPO_TOKEN=
SNAPSHOT_REPO=

SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
COOKIE_INSECURE=

# Where library files (covers, pictures, uploads) are stored. Default: ./library next to the app.
# On the host use a durable path outside the deployed folder, for example /private/library.
LIBRARY_ROOT=

# One-time wipe on the host (no shell there): set to a new tag, deploy, and the next start drops every table,
# empties the library folder and rebuilds the schema. Remove it after the first healthy start (src/db/reset.ts).
RESET_ALL_DATA=
