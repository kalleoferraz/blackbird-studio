{
  "name": "merulo-studio",
  "version": "0.0.1",
  "private": true,
  "description": "Merulo Studio: write, record and organize a media project (audiobook, textbook, film, series, podcast) in one place.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "web:dev": "vite --config web/vite.config.ts web",
    "web:build": "vite build --config web/vite.config.ts web",
    "web:typecheck": "tsc -p web/tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "drizzle-orm": "^0.45.4",
    "exifr": "^7.1.3",
    "fastify": "^5.12.5",
    "mpg123-decoder": "^1.0.3",
    "mysql2": "^3.24.5",
    "wasm-media-encoders": "^0.7.0",
    "wasm-vips": "^0.0.19"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  }
}
